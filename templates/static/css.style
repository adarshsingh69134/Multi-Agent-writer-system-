/* Multi-Agent Report Writer - style.css */

:root {
  --bg: #f4f6fa;
  --card: #ffffff;
  --text: #1c1f24;
  --muted: #6b7280;
  --line: #dfe3e8;
  --accent: #2f5bea;
  --accent-hover: #2449c4;
  --ok: #1a7f4b;
  --err: #c0362c;
  --radius: 12px;
  --shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 4px 12px rgba(16, 24, 40, 0.04);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0f1218;
    --card: #181c24;
    --text: #e8eaee;
    --muted: #9aa3b2;
    --line: #2a303b;
    --accent: #6c8cff;
    --accent-hover: #86a0ff;
    --ok: #3ecf8e;
    --err: #ff7b72;
    --shadow: none;
  }
  input, select { background: #11151c; }
  button { color: #0f1218; }
  button.secondary { color: var(--text); background: transparent; }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
}

main {
  max-width: 860px;
  margin: 0 auto;
  padding: 32px 16px 56px;
}

h1 {
  font-size: 1.6rem;
  margin: 0 0 4px;
  letter-spacing: -0.01em;
}

.sub {
  color: var(--muted);
  margin: 0 0 24px;
}

/* Cards */
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px;
  margin-bottom: 16px;
  box-shadow: var(--shadow);
}

/* Form */
label {
  display: block;
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 4px;
}

input,
select {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  font: inherit;
  background: #fff;
  color: var(--text);
}

input:focus,
select:focus {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
  border-color: transparent;
}

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 12px;
}

.api { margin-top: 12px; }

/* Buttons */
button {
  margin-top: 14px;
  padding: 10px 18px;
  border: 0;
  border-radius: 8px;
  background: var(--accent);
  color: #fff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease;
}

button:hover:not(:disabled) { background: var(--accent-hover); }

button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

button.secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
  margin-left: 8px;
}

button.secondary:hover:not(:disabled) { background: rgba(127, 127, 127, 0.1); }

/* Status line */
#status {
  font-size: 0.9rem;
  color: var(--muted);
  margin-top: 10px;
  min-height: 1.2em;
}

#status.error { color: var(--err); }

/* Agent progress list */
ul#steps {
  list-style: none;
  margin: 8px 0 0;
  padding: 0;
}

ul#steps li {
  display: flex;
  gap: 10px;
  align-items: baseline;
  padding: 9px 0;
  border-bottom: 1px solid var(--line);
}

ul#steps li:last-child { border-bottom: 0; }

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--ok);
  flex: none;
}

.detail {
  color: var(--muted);
  font-size: 0.85rem;
}

.time {
  color: var(--muted);
  font-size: 0.8rem;
  margin-left: auto;
  flex: none;
}

/* Report output */
.meta {
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 10px;
}

#report {
  white-space: pre-wrap;
  word-wrap: break-word;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.02rem;
  line-height: 1.7;
}

.hidden { display: none; }

/* Small screens */
@media (max-width: 560px) {
  .row { grid-template-columns: 1fr; }
  main { padding: 20px 12px 40px; }
}

/* Printing: show only the report */
@media print {
  body { background: #fff; color: #000; }
  .card:not(#reportCard) { display: none; }
  #reportCard { border: 0; box-shadow: none; }
  button { display: none; }
}